#!/usr/bin/env python3
"""ROS 2 node that publishes CLIP image feature embeddings."""

from dataclasses import dataclass, field

import rclpy
from rclpy.node import Node
import torch

import semantic_inference_python.models as models
import semantic_inference_ros

from semantic_inference_msgs.msg import FeatureVectorStamped
from semantic_inference_python import Config
from semantic_inference_ros import (
    Conversions,
    ImageWorkerConfig,
)


@dataclass
class ClipPublisherConfig(Config):
    """Configuration for ClipPublisherNode."""

    worker: ImageWorkerConfig = field(
        default_factory=ImageWorkerConfig
    )
    model: models.ClipConfig = field(
        default_factory=models.ClipConfig
    )


class ClipPublisherNode(Node):
    """Publish CLIP embeddings for incoming images."""

    def __init__(self) -> None:
        """Initialize configuration, model, publisher, and image worker."""
        super().__init__("clip_publisher_node")

        self.config = semantic_inference_ros.load_from_ros2(
            ClipPublisherConfig,
            self,
        )

        self.get_logger().info(
            f"'{self.get_name()}': Initializing with "
            f"{self.config.show()}"
        )

        self._device = models.default_device()

        self._model = models.ClipVisionWrapper(
            self.config.model
        ).to(self._device)

        self._model.eval()

        self._transform = models.get_image_preprocessor(
            self._model.input_size
        )
        self._transform = self._transform.to(
            self._device
        )

        self._pub = self.create_publisher(
            FeatureVectorStamped,
            "feature",
            1,
        )

        self._worker = semantic_inference_ros.ImageWorker(
            node=self,
            config=self.config.worker,
            topic="image",
            callback=self._spin_once,
        )

        self.get_logger().info(
            f"'{self.get_name()}': Finished initializing!"
        )

    def _spin_once(
        self,
        header,
        image,
    ) -> None:
        """Compute and publish a CLIP embedding for one image."""
        try:
            with torch.inference_mode():
                image_tensor = torch.from_numpy(
                    image
                ).to(self._device)

                if image_tensor.ndim != 3:
                    self.get_logger().error(
                        "Expected a three-dimensional image array, "
                        f"but received shape {tuple(image_tensor.shape)}."
                    )
                    return

                # Convert HWC image layout to CHW.
                image_tensor = image_tensor.permute(
                    2,
                    0,
                    1,
                )

                image_tensor = self._transform(
                    image_tensor
                )

                image_tensor = models.center_crop(
                    image_tensor,
                    self._model.input_size,
                )

                feature = self._model(
                    image_tensor.unsqueeze(0)
                )

                feature = torch.squeeze(
                    feature.detach().cpu()
                )

            message = Conversions.to_stamped_feature(
                header,
                feature,
            )

            self._pub.publish(message)

        except Exception as exception:
            self.get_logger().error(
                "Failed to compute CLIP image embedding: "
                f"{exception}"
            )

    def shutdown(self) -> None:
        """Stop the image worker."""
        if hasattr(self, "_worker") and self._worker is not None:
            stop_method = getattr(
                self._worker,
                "stop",
                None,
            )

            if callable(stop_method):
                stop_method()


def main(args=None) -> None:
    """Start the ROS 2 CLIP publisher node."""
    rclpy.init(args=args)

    node = ClipPublisherNode()

    try:
        rclpy.spin(node)
    except KeyboardInterrupt:
        pass
    finally:
        node.shutdown()
        node.destroy_node()

        if rclpy.ok():
            rclpy.shutdown()


if __name__ == "__main__":
    main()