#!/usr/bin/env python3
"""
ROS 2 node that encodes a prompt and objects, then computes their
relationship with visual features.
"""

from dataclasses import dataclass
from pathlib import Path
from typing import Any

import rclpy
from rclpy.node import Node

import semantic_inference_ros
from semantic_inference_python import Config, config_field
from semantic_inference_python.models import default_device


@dataclass
class EncodeVLMLabelsNodeConfig(Config):
    """Configuration for EncodeVLMLabelsNode."""

    vlm_prompt: Any = config_field(
        "vlm",
        default="cosmos_reason2",
    )
    use_bb_corners: bool = True
    use_cuda: bool = False
    geometry: semantic_inference_ros.VLMGeometry = (
        semantic_inference_ros.VLMGeometry.CENTER
    )
    full_img: bool = False
    crop_img_to_bb: bool = False


class EncodeVLMLabelsNode(Node):
    """Generate VLM text labels from prompts and visual features."""

    def __init__(self) -> None:
        """Initialize configuration, model, and VLM text generator."""
        super().__init__(
            "encode_vlm_labels_node",
            automatically_declare_parameters_from_overrides=True,
        )

        self.config = self._load_configuration()

        self.get_logger().info(
            f"'{self.get_name()}': Initializing with "
            f"{self.config.show()}"
        )

        if (
            not self.config.full_img
            or self.config.crop_img_to_bb
        ):
            self.config.vlm_prompt.cropping = False

        device = default_device(
            self.config.use_cuda
        )

        self._model = (
            self.config.vlm_prompt
            .create()
            .to(device)
        )

        self._model.eval()

        self._generator = semantic_inference_ros.VLMTextGenerator(
            node=self,
            model=self._model,
            geometry=self.config.geometry,
        )

        self.get_logger().info(
            f"'{self.get_name()}': finished initializing!"
        )

    def _load_configuration(self) -> EncodeVLMLabelsNodeConfig:
        """Load the prompting YAML and apply ROS 2 launch overrides."""
        config_path = Path(
            self.get_parameter("config_path").value
        ).expanduser()

        if not config_path.is_file():
            raise FileNotFoundError(
                "VLM prompting configuration file does not exist: "
                f"'{config_path}'"
            )

        config = Config.load(
            EncodeVLMLabelsNodeConfig,
            config_path,
        )

        ros_overrides = semantic_inference_ros.load_ros2_params(self)
        ros_overrides.pop("config_path", None)
        if ros_overrides:
            config.update(ros_overrides)

        if isinstance(config.geometry, str):
            config.geometry = semantic_inference_ros.VLMGeometry(
                config.geometry
            )

        return config


def main(args=None) -> None:
    """Start the ROS 2 encode-VLM-labels node."""
    rclpy.init(args=args)

    node = EncodeVLMLabelsNode()

    try:
        rclpy.spin(node)
    except KeyboardInterrupt:
        pass
    finally:
        node.destroy_node()

        if rclpy.ok():
            rclpy.shutdown()


if __name__ == "__main__":
    main()
