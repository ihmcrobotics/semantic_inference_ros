#!/usr/bin/env python3
"""ROS 2 node that extracts VLM relationship features."""

from dataclasses import dataclass, field
from pathlib import Path
import time
from typing import Optional

import cv2
import numpy as np
import rclpy
from rclpy.duration import Duration
from rclpy.node import Node
from rclpy.qos import qos_profile_sensor_data
from rclpy.time import Time
from scipy.spatial.transform import Rotation as R
import tf2_ros
import torch
import yaml

from hydra_msgs.msg import ActiveObjectRelationships
from semantic_inference_msgs.msg import FeatureVectorsStamped
from sensor_msgs.msg import CameraInfo, CompressedImage, Image
from std_msgs.msg import Header

import semantic_inference_python.models as models
import semantic_inference_ros

from semantic_inference_python import Config
from semantic_inference_ros import (
    Conversions,
    RecolorConfig,
    SyncImagesWorkerConfig,
)


@dataclass
class VLMFeatureNodeConfig(Config):
    """Configuration for the VLM feature extraction node."""

    worker: SyncImagesWorkerConfig = field(
        default_factory=SyncImagesWorkerConfig
    )
    model: models.VLMFeatureExtractorConfig = field(
        default_factory=models.VLMFeatureExtractorConfig
    )
    recolor: RecolorConfig = field(
        default_factory=RecolorConfig
    )
    playback_mode: bool = False
    print_inference_time: bool = False
    world_frame: str = "world"
    camera_frame: str = "camera_color_optical_frame"


class VLMFeaturesNode(Node):
    """Run VLM inference on semantic segmentation and RGB-D images."""

    def __init__(self) -> None:
        """Initialize the model, publishers, subscribers, and worker."""
        super().__init__(
            "vlm_features_node",
            automatically_declare_parameters_from_overrides=True,
        )

        self.config = self._load_configuration()

        self.get_logger().info(
            f"'{self.get_name()}': Initializing with "
            f"{self.config.show()}"
        )

        device = models.default_device(
            self.config.model.cuda
        )

        recolor = semantic_inference_ros.Recolor(
            self.config.recolor
        )

        rgb_to_id = {
            tuple(rgba[:3]): class_id
            for class_id, rgba in recolor.id_to_rgba.items()
        }
        rgb_to_id[(255, 255, 255)] = 0

        id_to_name = {
            class_id: class_name
            for class_name, class_id in recolor.name_to_id.items()
        }

        self._model = models.VLMFeatureExtractor(
            self.config.model,
            rgb_to_id,
            id_to_name,
        )

        self._model.move_to(device)
        self._model.eval()

        self.camera_matrix: Optional[np.ndarray] = None
        self.map1: Optional[np.ndarray] = None
        self.map2: Optional[np.ndarray] = None

        self._vlm_pub = self.create_publisher(
            FeatureVectorsStamped,
            "relation_features",
            20,
        )

        if self.config.model.publish_masks:
            self._mask_pub = self.create_publisher(
                Image,
                "relation_annotations",
                20,
            )
        else:
            self._mask_pub = None

        self._active_edges_sub = None
        self.tf_buffer = None
        self.tf_listener = None

        if self._model.config.use_graph_edges:
            self._active_edges_sub = self.create_subscription(
                ActiveObjectRelationships,
                "active_object_edges",
                self.set_active_edges,
                10,
            )

            self.tf_buffer = tf2_ros.Buffer()
            self.tf_listener = tf2_ros.TransformListener(
                self.tf_buffer,
                self,
            )

        self._camera_info_sub = self.create_subscription(
            CameraInfo,
            "color/camera_info",
            self.callback_camera_info,
            qos_profile_sensor_data,
        )

        message_types = (
            [Image, Image, Image, Image]
            if not self.config.playback_mode
            else [
                CompressedImage,
                Image,
                Image,
                CompressedImage,
            ]
        )

        self._worker = semantic_inference_ros.SyncImagesWorker(
            node=self,
            config=self.config.worker,
            topics=[
                "color/image_raw",
                "semantic_color/image_raw",
                "panoptic/image_raw",
                "depth/image_raw",
            ],
            message_types=message_types,
            callback=self._spin_once,
        )

        self.get_logger().info(
            f"'{self.get_name()}': finished initializing!"
        )

    def _load_configuration(self) -> VLMFeatureNodeConfig:
        """Load the VLM YAML and apply ROS 2 launch overrides."""
        config_path = Path(
            self.get_parameter("config_path").value
        ).expanduser()

        if not config_path.is_file():
            raise FileNotFoundError(
                f"VLM configuration file does not exist: '{config_path}'"
            )

        config = VLMFeatureNodeConfig()
        config.model = Config.load(
            models.VLMFeatureExtractorConfig,
            config_path,
        )

        ros_overrides = semantic_inference_ros.load_ros2_params(self)
        ros_overrides.pop("config_path", None)
        labelspace_path_value = ros_overrides.pop(
            "labelspace_path",
            None,
        )

        if ros_overrides:
            config.update(ros_overrides)

        if labelspace_path_value:
            labelspace_path = Path(
                labelspace_path_value
            ).expanduser()

            if not labelspace_path.is_file():
                raise FileNotFoundError(
                    "Label-space configuration file does not exist: "
                    f"'{labelspace_path}'"
                )

            with labelspace_path.open("r") as labelspace_file:
                labelspace = yaml.safe_load(labelspace_file) or {}

            config.model.object_labels = [
                int(label_id)
                for label_id in labelspace.get("object_labels", [])
            ]

        return config

    def set_active_edges(
        self,
        msg: ActiveObjectRelationships,
    ) -> None:
        """Update active object relationships from Hydra."""
        bounding_boxes = []

        for box in msg.object_boxes:
            world_position = torch.tensor(
                [
                    box.center.position.x,
                    box.center.position.y,
                    box.center.position.z,
                ],
                dtype=torch.float32,
                device=self._model.device,
            )

            world_rotation = torch.tensor(
                R.from_quat(
                    [
                        box.center.orientation.x,
                        box.center.orientation.y,
                        box.center.orientation.z,
                        box.center.orientation.w,
                    ]
                ).as_matrix(),
                dtype=torch.float32,
                device=self._model.device,
            )

            dimensions = torch.tensor(
                [
                    box.size.x,
                    box.size.y,
                    box.size.z,
                ],
                dtype=torch.float32,
                device=self._model.device,
            )

            bounding_boxes.append(
                models.BoundingBox(
                    world_P_center=world_position,
                    world_R_center=world_rotation,
                    dimensions=dimensions,
                )
            )

        relationships = set()

        for index in range(len(msg.object_ids) // 2):
            first_id = msg.object_ids[2 * index]
            second_id = msg.object_ids[2 * index + 1]

            if first_id > second_id:
                relationships.add((first_id, second_id))
            else:
                relationships.add((second_id, first_id))

        self._model.active_relations = models.ActiveRelations(
            bounding_boxes=bounding_boxes,
            relationships=relationships,
        )

    def callback_camera_info(
        self,
        msg: CameraInfo,
    ) -> None:
        """Initialize camera calibration and undistortion maps."""
        self.camera_matrix = np.asarray(
            msg.k,
            dtype=np.float64,
        ).reshape((3, 3))

        distortion = np.asarray(
            msg.d,
            dtype=np.float64,
        )

        image_size = (
            int(msg.width),
            int(msg.height),
        )

        self.map1, self.map2 = cv2.initUndistortRectifyMap(
            self.camera_matrix,
            distortion,
            None,
            self.camera_matrix,
            image_size,
            cv2.CV_16SC2,
        )

        self.get_logger().info(
            "[VLM node] Undistortion maps initialized"
        )

        if self._camera_info_sub is not None:
            self.destroy_subscription(
                self._camera_info_sub
            )
            self._camera_info_sub = None

    def _lookup_camera_transform(
        self,
        header: Header,
    ) -> Optional[torch.Tensor]:
        """Look up the transform from the camera frame to the world frame."""
        if self.tf_buffer is None:
            return None

        try:
            raw_transform = self.tf_buffer.lookup_transform(
                self.config.world_frame,
                self.config.camera_frame,
                Time.from_msg(header.stamp),
                timeout=Duration(seconds=1.0),
            )
        except tf2_ros.TransformException as exception:
            self.get_logger().warning(
                "[VLM node] Could not get transform from "
                f"'{self.config.camera_frame}' to "
                f"'{self.config.world_frame}': {exception}"
            )
            return None

        transform = torch.eye(
            4,
            dtype=torch.float32,
            device=self._model.device,
        )

        transform[:3, :3] = torch.tensor(
            R.from_quat(
                [
                    raw_transform.transform.rotation.x,
                    raw_transform.transform.rotation.y,
                    raw_transform.transform.rotation.z,
                    raw_transform.transform.rotation.w,
                ]
            ).as_matrix(),
            dtype=torch.float32,
            device=self._model.device,
        )

        transform[:3, 3] = torch.tensor(
            [
                raw_transform.transform.translation.x,
                raw_transform.transform.translation.y,
                raw_transform.transform.translation.z,
            ],
            dtype=torch.float32,
            device=self._model.device,
        )

        return transform

    def _spin_once(
        self,
        header: Header,
        color_image: np.ndarray,
        semantic_image: np.ndarray,
        panoptic_image: np.ndarray,
        depth_image: np.ndarray,
    ) -> None:
        """Run one VLM feature-extraction iteration."""
        start_time = time.perf_counter()

        if (
            self.map1 is None
            or self.map2 is None
            or self.camera_matrix is None
        ):
            self.get_logger().warning(
                "[VLM node] Undistortion maps are not initialized yet. "
                "Skipping processing."
            )
            return

        transform = None

        if self._model.config.use_graph_edges:
            transform = self._lookup_camera_transform(
                header
            )

            if transform is None:
                return

        color_image = cv2.remap(
            color_image,
            self.map1,
            self.map2,
            interpolation=cv2.INTER_LINEAR,
        )

        depth_image = cv2.remap(
            depth_image,
            self.map1,
            self.map2,
            interpolation=cv2.INTER_NEAREST,
        )

        if depth_image.dtype == np.uint16:
            depth_image = (
                depth_image.astype(np.float32)
                / 1000.0
            )
        elif depth_image.dtype != np.float32:
            self.get_logger().error(
                "[VLM node] Depth image has unsupported dtype "
                f"{depth_image.dtype}. Expected uint16 or float32."
            )
            return

        with torch.inference_mode():
            (
                vlm_features,
                panoptic_ids,
                annotation_image,
            ) = self._model(
                np.asarray(color_image).copy(),
                np.asarray(semantic_image).copy(),
                np.asarray(panoptic_image).copy(),
                np.asarray(depth_image).copy(),
                choice=None,
                camera_matrix=self.camera_matrix,
                transform=transform,
            )

        if self.config.print_inference_time:
            inference_time_ms = (
                time.perf_counter() - start_time
            ) * 1000.0

            self.get_logger().info(
                "[VLM node] Total inference time: "
                f"{inference_time_ms:.3f} ms"
            )

        feature_message = Conversions.to_stamped_features(
            header,
            vlm_features,
            panoptic_ids,
        )
        self._vlm_pub.publish(feature_message)

        if (
            self._mask_pub is not None
            and annotation_image is not None
        ):
            annotation_message = (
                Conversions.to_sensor_image(
                    annotation_image,
                    header=header,
                    encoding="rgb8",
                )
            )
            self._mask_pub.publish(annotation_message)

    def shutdown(self) -> None:
        """Stop the image synchronization worker."""
        if hasattr(self, "_worker"):
            stop_method = getattr(
                self._worker,
                "stop",
                None,
            )

            if callable(stop_method):
                stop_method()


def main(args=None) -> None:
    """Start the ROS 2 VLM feature node."""
    rclpy.init(args=args)

    node = VLMFeaturesNode()

    try:
        rclpy.spin(node)
    except KeyboardInterrupt:
        pass
    finally:
        node.shutdown()
        node.destroy_node()

        if rclpy.ok():
            rclpy.shutdown()


if __name__ == "__main__":
    main()
