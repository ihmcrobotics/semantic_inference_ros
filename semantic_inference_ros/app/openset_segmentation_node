#!/usr/bin/env python3
"""ROS 2 node that runs open-set RGB-D segmentation."""

from __future__ import annotations

from dataclasses import dataclass, field
from pathlib import Path
import time
from typing import Any, Dict, Optional

import cv2
import numpy as np
import rclpy
from rclpy.node import Node
from rclpy.qos import qos_profile_sensor_data
import torch
import yaml

import semantic_inference_python.models as models
import semantic_inference_ros

from semantic_inference_python import Config
from semantic_inference_msgs.msg import (
    FeatureImage,
    FeatureVectorStamped,
)
from sensor_msgs.msg import (
    CameraInfo,
    CompressedImage,
    Image,
)
from semantic_inference_ros import (
    Conversions,
    RecolorConfig,
    SyncImagesWorkerConfig,
)


@dataclass
class OpensetSegmentationNodeConfig(Config):
    """Configuration for the open-set segmentation node."""

    worker: SyncImagesWorkerConfig = field(
        default_factory=SyncImagesWorkerConfig
    )
    model: models.OpensetSegmenterConfig = field(
        default_factory=models.OpensetSegmenterConfig
    )
    recolor: RecolorConfig = field(
        default_factory=RecolorConfig
    )
    playback_mode: bool = False
    print_inference_time: bool = False


class OpensetSegmentationNode(Node):
    """Run open-set segmentation on synchronized RGB-D images."""

    _PATH_PARAMETERS = {
        "config_path",
        "labelspace_path",
        "label_grouping_path",
    }

    def __init__(self) -> None:
        """Initialize the ROS 2 node, model, publishers, and subscribers."""
        super().__init__(
            "openset_segmentation_node",
            automatically_declare_parameters_from_overrides=True,
        )

        semantic_inference_ros.setup_ros_log_forwarding(
            node=self
        )

        self.config = self._load_configuration()

        self.get_logger().info(
            f"'{self.get_name()}': Initializing with "
            f"{self.config.show()}"
        )

        device = models.default_device(
            self.config.model.cuda
        )

        self._recolor = semantic_inference_ros.Recolor(
            self.config.recolor
        )

        id_to_name = {
            class_id: class_name
            for class_name, class_id
            in self._recolor.name_to_id.items()
        }

        self._model = models.OpensetSegmenter(
            self.config.model,
            id_to_name,
        )
        self._model.to_device(device)

        self.map1: Optional[np.ndarray] = None
        self.map2: Optional[np.ndarray] = None

        self._worker = None
        self._camera_info_sub = None

        self._create_publishers()
        self._create_subscriptions()

        self.get_logger().info(
            f"'{self.get_name()}': finished initializing!"
        )

    def _load_configuration(
        self,
    ) -> OpensetSegmentationNodeConfig:
        """
        Load the original application configuration and apply ROS 2 overrides.

        Loading order:

        1. Main open-set segmentation YAML.
        2. ROS 2 launch overrides.
        3. Label-space YAML.
        4. Label-grouping YAML.

        The label files are applied last because the generic ROS 2 parameter
        loader may contain empty default values for groups and object_labels.
        """
        config_path = self._get_path_parameter(
            "config_path",
            required=True,
        )

        labelspace_path = self._get_path_parameter(
            "labelspace_path",
            required=False,
        )

        label_grouping_path = self._get_path_parameter(
            "label_grouping_path",
            required=False,
        )

        # Load the main application configuration.
        config = Config.load(
            OpensetSegmentationNodeConfig,
            config_path,
        )

        self.get_logger().info(
            f"Loaded main configuration from '{config_path}'."
        )

        # Apply normal ROS 2 launch overrides.
        ros_overrides = semantic_inference_ros.load_ros2_params(
            node=self,
        )

        for path_parameter in self._PATH_PARAMETERS:
            ros_overrides.pop(
                path_parameter,
                None,
            )

        if ros_overrides:
            config.update(
                ros_overrides
            )

        # Load the object-label IDs after ROS overrides so that empty default
        # parameter values cannot overwrite them.
        if labelspace_path is not None:
            labelspace_configuration = self._load_yaml_dictionary(
                labelspace_path
            )

            object_labels = labelspace_configuration.get(
                "object_labels",
                [],
            )

            if object_labels:
                config.model.object_labels = [
                    int(label_id)
                    for label_id in object_labels
                ]

            self.get_logger().info(
                f"Loaded label-space configuration from "
                f"'{labelspace_path}'."
            )

        # Load the YOLOE class names and their source label IDs.
        if label_grouping_path is not None:
            label_grouping_configuration = self._load_yaml_dictionary(
                label_grouping_path
            )

            raw_groups = label_grouping_configuration.get(
                "groups",
                [],
            )

            if not isinstance(raw_groups, list):
                raise TypeError(
                    f"The 'groups' field in '{label_grouping_path}' "
                    "must be a list."
                )

            groups = []

            for index, group in enumerate(raw_groups):
                if not isinstance(group, dict):
                    raise TypeError(
                        f"Group {index} in '{label_grouping_path}' "
                        "must be a dictionary."
                    )

                if "name" not in group:
                    raise ValueError(
                        f"Group {index} in '{label_grouping_path}' "
                        "does not contain a 'name'."
                    )

                if "labels" not in group:
                    raise ValueError(
                        f"Group {index} in '{label_grouping_path}' "
                        "does not contain 'labels'."
                    )

                labels = [
                    int(label_id)
                    for label_id in group["labels"]
                ]

                groups.append(
                    {
                        "name": str(group["name"]),
                        "labels": labels,
                    }
                )

            # YOLOEConfig.parse_groups() converts these dictionaries into
            # GroupInfo objects while constructing YOLOESegmentation.
            config.model.segmentation.update(
                {
                    "groups": groups,
                }
            )   

            # Keep the object-label subset supplied by the Hydra label-space file.
            # Derive it from all groups only when the label-space file did not
            # provide one.
            if not config.model.object_labels:
                config.model.object_labels = [
                    label_id
                    for group in groups
                    for label_id in group["labels"]
                ]

            self.get_logger().info(
                f"Loaded label-grouping configuration from "
                f"'{label_grouping_path}' with "
                f"{len(groups)} groups and "
                f"{len(config.model.object_labels)} object labels."
            )

        return config

    def _get_path_parameter(
        self,
        parameter_name: str,
        *,
        required: bool,
    ) -> Optional[Path]:
        """Read and validate a path-valued ROS 2 parameter."""
        if not self.has_parameter(parameter_name):
            if required:
                raise RuntimeError(
                    f"Required parameter '{parameter_name}' "
                    "was not provided."
                )

            return None

        raw_value = self.get_parameter(
            parameter_name
        ).value

        if raw_value is None or str(raw_value).strip() == "":
            if required:
                raise RuntimeError(
                    f"Required parameter '{parameter_name}' "
                    "is empty."
                )

            return None

        path = Path(
            str(raw_value)
        ).expanduser()

        if not path.is_file():
            raise FileNotFoundError(
                f"File provided through '{parameter_name}' "
                f"does not exist: '{path}'"
            )

        return path

    @staticmethod
    def _load_yaml_dictionary(
        path: Path,
    ) -> Dict[str, Any]:
        """Load an ordinary application YAML file as a dictionary."""
        with path.open(
            "r",
            encoding="utf-8",
        ) as yaml_file:
            contents = yaml.safe_load(
                yaml_file
            )

        if contents is None:
            return {}

        if not isinstance(contents, dict):
            raise TypeError(
                f"Expected YAML file '{path}' to contain a mapping, "
                f"but received {type(contents).__name__}."
            )

        return contents

    def _create_publishers(self) -> None:
        """Create output publishers."""
        self._pub = self.create_publisher(
            FeatureImage,
            "semantic/image_raw",
            1,
        )

        self._feature_image_color_pub = self.create_publisher(
            FeatureImage,
            "semantic_color/feature_image",
            1,
        )

        self._colored_image_pub = self.create_publisher(
            Image,
            "semantic_color/image_raw",
            1,
        )

        self._panoptic_image_pub = self.create_publisher(
            Image,
            "panoptic/image_raw",
            1,
        )

        self._clip_pub = self.create_publisher(
            FeatureVectorStamped,
            "image_feature",
            1,
        )

        self._debug_pub = self.create_publisher(
            Image,
            "detections",
            1,
        )

    def _create_subscriptions(self) -> None:
        """Create camera-info and synchronized RGB-D subscriptions."""
        self._camera_info_sub = self.create_subscription(
            CameraInfo,
            "color/camera_info",
            self.callback_camera_info,
            qos_profile_sensor_data,
        )

        image_types = (
            [Image, Image]
            if not self.config.playback_mode
            else [CompressedImage, CompressedImage]
        )

        self._worker = semantic_inference_ros.SyncImagesWorker(
            node=self,
            config=self.config.worker,
            topics=[
                "color/image_raw",
                "depth/image_raw",
            ],
            message_types=image_types,
            callback=self._spin_once,
        )

    def callback_camera_info(
        self,
        msg: CameraInfo,
    ) -> None:
        """Initialize image-undistortion maps from camera calibration."""
        camera_matrix = np.asarray(
            msg.k,
            dtype=np.float64,
        ).reshape((3, 3))

        distortion = np.asarray(
            msg.d,
            dtype=np.float64,
        )

        image_size = (
            int(msg.width),
            int(msg.height),
        )

        self.map1, self.map2 = cv2.initUndistortRectifyMap(
            camera_matrix,
            distortion,
            None,
            camera_matrix,
            image_size,
            cv2.CV_16SC2,
        )

        self.get_logger().info(
            "[Open vocabulary node] "
            "Undistortion maps initialized."
        )

        if self._camera_info_sub is not None:
            self.destroy_subscription(
                self._camera_info_sub
            )
            self._camera_info_sub = None

    def _spin_once(
        self,
        header,
        image: np.ndarray,
        depth: np.ndarray,
    ) -> None:
        """Run segmentation for one synchronized RGB-D pair."""
        start_time = time.perf_counter()

        if self.map1 is None or self.map2 is None:
            self.get_logger().warning(
                "[Open vocabulary node] Undistortion maps are not "
                "initialized yet. Skipping processing."
            )
            return

        image = cv2.remap(
            image,
            self.map1,
            self.map2,
            interpolation=cv2.INTER_LINEAR,
        )

        depth = cv2.remap(
            depth,
            self.map1,
            self.map2,
            interpolation=cv2.INTER_LINEAR,
        )

        # Conversions.to_image() normally converts depth to float32 meters.
        # Keep this check for direct uint16 inputs.
        if depth.dtype == np.uint16:
            depth = (
                depth.astype(np.float32)
                / 1000.0
            )
        elif depth.dtype != np.float32:
            self.get_logger().error(
                "[Open vocabulary node] Depth image has unsupported "
                f"dtype {depth.dtype}. Expected uint16 or float32."
            )
            return

        with torch.no_grad():
            result, debug_image = self._model.segment(
                image,
                depth,
                colors=self._recolor.get_colorpalette(),
                is_rgb_order=True,
            )

        if self.config.print_inference_time:
            inference_time_ms = (
                time.perf_counter()
                - start_time
            ) * 1000.0

            stamp = header.stamp

            self.get_logger().info(
                "[Open vocabulary node] Inference time for image "
                f"stamp {stamp.sec}.{stamp.nanosec:09d}: "
                f"{inference_time_ms:.3f} ms"
            )

        self._publish_segmentation_results(
            header=header,
            image=image,
            result=result,
            debug_image=debug_image,
        )

    def _publish_segmentation_results(
        self,
        *,
        header,
        image: np.ndarray,
        result,
        debug_image,
    ) -> None:
        """Convert and publish segmentation outputs."""
        feature_image = Conversions.to_feature_image(
            header,
            result,
        )
        self._pub.publish(
            feature_image
        )

        stamped_feature = Conversions.to_stamped_feature(
            header,
            result.image_embedding,
        )
        self._clip_pub.publish(
            stamped_feature
        )

        if debug_image is not None:
            debug_msg = Conversions.to_sensor_image(
                debug_image,
                header=header,
                encoding="rgb8",
            )
            self._debug_pub.publish(
                debug_msg
            )

        if result.labels is not None:
            colored_result = self._recolor.recolor_image(
                result.masks,
                result.labels,
            )

            colored_feature_image = (
                Conversions.to_colored_feature_image(
                    header,
                    result,
                    colored_result,
                )
            )

            panoptic_image = result.panoptic_image

            if isinstance(
                panoptic_image,
                torch.Tensor,
            ):
                panoptic_array = (
                    panoptic_image
                    .detach()
                    .cpu()
                    .numpy()
                    .astype(np.int16)
                )
            else:
                panoptic_array = np.asarray(
                    panoptic_image,
                    dtype=np.int16,
                )

            # Remove a leading singleton channel if present.
            if (
                panoptic_array.ndim == 3
                and panoptic_array.shape[0] == 1
            ):
                panoptic_array = panoptic_array[0]

        else:
            colored_result = np.zeros(
                (
                    image.shape[0],
                    image.shape[1],
                    3,
                ),
                dtype=np.uint8,
            )

            colored_feature_image = (
                Conversions.to_colored_feature_image(
                    header,
                    result,
                    colored_result,
                )
            )

            panoptic_array = np.zeros(
                (
                    image.shape[0],
                    image.shape[1],
                ),
                dtype=np.int16,
            )

        panoptic_msg = Conversions.to_sensor_image(
            panoptic_array,
            header=header,
            encoding="16SC1",
        )

        self._panoptic_image_pub.publish(
            panoptic_msg
        )

        self._feature_image_color_pub.publish(
            colored_feature_image
        )

        self._colored_image_pub.publish(
            colored_feature_image.image
        )

    def shutdown(self) -> None:
        """Stop the synchronized-image worker."""
        if self._worker is not None:
            self._worker.stop()
            self._worker = None


def main(args=None) -> None:
    """Start the ROS 2 node."""
    rclpy.init(
        args=args
    )

    node: Optional[OpensetSegmentationNode] = None

    try:
        node = OpensetSegmentationNode()
        rclpy.spin(
            node
        )
    except KeyboardInterrupt:
        pass
    finally:
        if node is not None:
            node.shutdown()
            node.destroy_node()

        if rclpy.ok():
            rclpy.shutdown()


if __name__ == "__main__":
    main()