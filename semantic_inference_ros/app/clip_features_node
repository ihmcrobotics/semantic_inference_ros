#!/usr/bin/env python3
"""ROS 2 node that extracts CLIP features from RGB-D segmentation data."""

from dataclasses import dataclass, field
from typing import Optional

import cv2
import numpy as np
import rclpy
from rclpy.node import Node
from rclpy.qos import qos_profile_sensor_data
import torch

import semantic_inference_python.models as models
import semantic_inference_ros

from semantic_inference_msgs.msg import FeatureImage, FeatureVectorStamped
from semantic_inference_python import Config
from semantic_inference_ros import (
    Conversions,
    RecolorConfig,
    SyncImagesWorkerConfig,
)
from sensor_msgs.msg import CameraInfo, CompressedImage, Image


@dataclass
class CLIPFeaturesNodeConfig(Config):
    """Configuration for the CLIP feature-extraction node."""

    worker: SyncImagesWorkerConfig = field(
        default_factory=SyncImagesWorkerConfig
    )
    model: models.CLIPFeaturesExtractorConfig = field(
        default_factory=models.CLIPFeaturesExtractorConfig
    )
    recolor: RecolorConfig = field(
        default_factory=RecolorConfig
    )
    playback_mode: bool = False


class CLIPFeaturesNode(Node):
    """Run CLIP inference on segmentation masks and RGB-D images."""

    def __init__(self) -> None:
        """Initialize the model, publishers, subscribers, and worker."""
        super().__init__("clip_features_node")

        self.config = semantic_inference_ros.load_from_ros2(
            CLIPFeaturesNodeConfig,
            self,
        )

        self.get_logger().info(
            f"'{self.get_name()}': Initializing with "
            f"{self.config.show()}"
        )

        device = models.default_device(
            self.config.model.cuda
        )

        recolor = semantic_inference_ros.Recolor(
            self.config.recolor
        )

        rgb_to_id = {
            tuple(rgba[:3]): class_id
            for class_id, rgba in recolor.id_to_rgba.items()
        }

        id_to_name = {
            class_id: class_name
            for class_name, class_id in recolor.name_to_id.items()
        }

        self._model = models.CLIPFeaturesExtractor(
            self.config.model,
            rgb_to_id,
            id_to_name,
        ).to(device)

        self._model.eval()

        self.map1: Optional[np.ndarray] = None
        self.map2: Optional[np.ndarray] = None

        self._feature_image_color_pub = self.create_publisher(
            FeatureImage,
            "semantic_color/feature_image",
            1,
        )

        self._clip_pub = self.create_publisher(
            FeatureVectorStamped,
            "image_feature",
            1,
        )

        self._camera_info_sub = self.create_subscription(
            CameraInfo,
            "color/camera_info",
            self.callback_camera_info,
            qos_profile_sensor_data,
        )

        message_types = (
            [Image, Image, Image, Image]
            if not self.config.playback_mode
            else [
                CompressedImage,
                Image,
                Image,
                CompressedImage,
            ]
        )

        self._worker = semantic_inference_ros.SyncImagesWorker(
            node=self,
            config=self.config.worker,
            topics=[
                "color/image_raw",
                "semantic_color/image_raw",
                "panoptic/image_raw",
                "depth/image_raw",
            ],
            message_types=message_types,
            callback=self._spin_once,
        )

        self.get_logger().info(
            f"'{self.get_name()}': finished initializing!"
        )

    def callback_camera_info(
        self,
        msg: CameraInfo,
    ) -> None:
        """Initialize undistortion maps from camera calibration."""
        camera_matrix = np.asarray(
            msg.k,
            dtype=np.float64,
        ).reshape((3, 3))

        distortion = np.asarray(
            msg.d,
            dtype=np.float64,
        )

        image_size = (
            int(msg.width),
            int(msg.height),
        )

        self.map1, self.map2 = cv2.initUndistortRectifyMap(
            camera_matrix,
            distortion,
            None,
            camera_matrix,
            image_size,
            cv2.CV_16SC2,
        )

        self.get_logger().info(
            "[CLIP node] Undistortion maps initialized"
        )

        if self._camera_info_sub is not None:
            self.destroy_subscription(
                self._camera_info_sub
            )
            self._camera_info_sub = None

    def _spin_once(
        self,
        header,
        color_image: np.ndarray,
        semantic_image: np.ndarray,
        panoptic_image: np.ndarray,
        depth_image: np.ndarray,
    ) -> None:
        """Compute and publish CLIP features."""
        if self.map1 is None or self.map2 is None:
            self.get_logger().warning(
                "[CLIP node] Undistortion maps are not initialized "
                "yet. Skipping processing."
            )
            return

        color_image = cv2.remap(
            color_image,
            self.map1,
            self.map2,
            interpolation=cv2.INTER_LINEAR,
        )

        depth_image = cv2.remap(
            depth_image,
            self.map1,
            self.map2,
            interpolation=cv2.INTER_NEAREST,
        )

        if depth_image.dtype == np.uint16:
            depth_image = (
                depth_image.astype(np.float32)
                / 1000.0
            )
        elif depth_image.dtype != np.float32:
            self.get_logger().error(
                "[CLIP node] Depth image has unsupported dtype "
                f"{depth_image.dtype}. Expected uint16 or float32."
            )
            return

        with torch.inference_mode():
            result = self._model(
                np.asarray(color_image).copy(),
                np.asarray(semantic_image).copy(),
                np.asarray(panoptic_image).copy(),
                np.asarray(depth_image).copy(),
            )

        result = result.cpu()

        stamped_feature = Conversions.to_stamped_feature(
            header,
            result.image_embedding,
        )

        self._clip_pub.publish(
            stamped_feature
        )

        colored_feature_image = (
            Conversions.to_colored_feature_image(
                header,
                result,
                semantic_image,
            )
        )

        self._feature_image_color_pub.publish(
            colored_feature_image
        )

    def shutdown(self) -> None:
        """Stop the synchronized-image worker."""
        if hasattr(self, "_worker") and self._worker is not None:
            stop_method = getattr(
                self._worker,
                "stop",
                None,
            )

            if callable(stop_method):
                stop_method()


def main(args=None) -> None:
    """Start the ROS 2 CLIP feature node."""
    rclpy.init(args=args)

    node = CLIPFeaturesNode()

    try:
        rclpy.spin(node)
    except KeyboardInterrupt:
        pass
    finally:
        node.shutdown()
        node.destroy_node()

        if rclpy.ok():
            rclpy.shutdown()


if __name__ == "__main__":
    main()