#!/usr/bin/env python3
"""ROS 2 node that encodes language prompts as embeddings."""

from dataclasses import dataclass
from typing import Any

import rclpy
from rclpy.node import Node

import semantic_inference_ros
from semantic_inference_python import Config, config_field
from semantic_inference_python.models import default_device


@dataclass
class LanguageEmbeddingNodeConfig(Config):
    """Configuration for LanguageEmbeddingNode."""

    model: Any = config_field(
        "clip",
        default="open_clip",
    )
    use_cuda: bool = True


class LanguageEmbeddingNode(Node):
    """Provide language-prompt embedding services."""

    def __init__(self) -> None:
        """Initialize the model and prompt encoder."""
        super().__init__("language_embedding_node")

        self.config = semantic_inference_ros.load_from_ros2(
            LanguageEmbeddingNodeConfig,
            self,
        )

        self.get_logger().info(
            f"'{self.get_name()}': Initializing with "
            f"{self.config.show()}"
        )

        device = default_device(
            self.config.use_cuda
        )

        self._model = (
            self.config.model
            .create()
            .to(device)
        )

        self._model.eval()

        self._embedder = semantic_inference_ros.PromptEncoder(
            node=self,
            model=self._model,
        )

        self.get_logger().info(
            f"'{self.get_name()}': finished initializing!"
        )


def main(args=None) -> None:
    """Start the ROS 2 language-embedding node."""
    rclpy.init(args=args)

    node = LanguageEmbeddingNode()

    try:
        rclpy.spin(node)
    except KeyboardInterrupt:
        pass
    finally:
        node.destroy_node()

        if rclpy.ok():
            rclpy.shutdown()


if __name__ == "__main__":
    main()